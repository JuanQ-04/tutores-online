rules_version = '2';

// ============================================================================
//  PROPUESTA de reglas para TutoresOn-Line  —  NO PROBADA contra tu proyecto.
//  Actualización: se agregaron «calificaciones», «mensajesSoporte» y «hojasDeVida».
//
//  Cómo usarla: Firebase Console → Firestore Database → Reglas. Pega el
//  contenido, pulsa «Simulador de reglas» y prueba estos casos ANTES de publicar:
//    1) estudiante leyendo usuarios con rol=tutor y estado=aprobado   → permitido
//    2) estudiante leyendo el documento de otro estudiante             → denegado
//    3) tutor completando su perfil (incompleto → pendiente)           → permitido
//
//  Lo importante para «Buscar tutores»: un estudiante autenticado puede LEER
//  los perfiles de tutores aprobados. Sin eso, la consulta falla con
//  «permission-denied» y la lista no carga.
//
//  Ojo: esa regla expone TODOS los campos del documento del tutor (correo,
//  nombre del PDF, etc.). Si más adelante quieres ocultarlos, guarda los datos
//  públicos en otra colección (p. ej. «tutoresPublicos») y lee esa.
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    function esAdmin() {
      return autenticado()
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
    }

    // ---------------------------------------------------------------- usuarios
    match /usuarios/{uid} {
      // Cualquiera (incluso sin sesión) puede leer los tutores aprobados:
      // alimenta el catálogo público de buscar.html. Tu propio perfil o
      // todos si eres admin requieren sesión.
      allow read: if (resource.data.rol == 'tutor'
                      && resource.data.estado in ['aprobado', 'aceptado'])
        || (autenticado() && (request.auth.uid == uid || esAdmin()));

      // Registro: solo tu propio documento y nunca como admin ni ya aprobado.
      allow create: if autenticado()
        && request.auth.uid == uid
        && request.resource.data.rol in ['estudiante', 'tutor']
        && request.resource.data.estado in ['activo', 'incompleto'];

      // Editar tu perfil sin cambiar tu rol ni tu estado. Única excepción:
      // el tutor envía su solicitud (incompleto → pendiente).
      allow update: if autenticado() && (
        esAdmin() ||
        (request.auth.uid == uid
          && request.resource.data.rol == resource.data.rol
          && (request.resource.data.estado == resource.data.estado
              || (resource.data.estado == 'incompleto'
                  && request.resource.data.estado == 'pendiente'))
          // La foto de perfil es un texto (data URL) de menos de ~300 KB.
          && (!('fotoURL' in request.resource.data)
              || (request.resource.data.fotoURL is string
                  && request.resource.data.fotoURL.size() < 300000)))
      );
    }

    // ------------------------------------------------------------- solicitudes
    match /solicitudes/{id} {
      allow read: if autenticado() && (
        resource.data.estudianteId == request.auth.uid ||
        resource.data.tutorId == request.auth.uid ||
        esAdmin()
      );

      allow create: if autenticado()
        && request.resource.data.estudianteId == request.auth.uid
        && request.resource.data.estado == 'pendiente';

      // El estudiante solo puede cancelar (→ rechazada); el tutor acepta o rechaza.
      allow update: if autenticado()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado'])
        && (
          (resource.data.estudianteId == request.auth.uid
            && request.resource.data.estado == 'rechazada') ||
          (resource.data.tutorId == request.auth.uid
            && request.resource.data.estado in ['aceptada', 'rechazada'])
        );
    }

    // ---------------------------------------------------------------- tutorias
    match /tutorias/{id} {
      allow read: if autenticado() && (
        resource.data.estudianteId == request.auth.uid ||
        resource.data.tutorId == request.auth.uid ||
        esAdmin()
      );

      // La crea el tutor al aceptar una solicitud.
      allow create: if autenticado()
        && request.resource.data.tutorId == request.auth.uid
        && request.resource.data.estado == 'programada';

      allow update: if autenticado()
        && (resource.data.estudianteId == request.auth.uid
            || resource.data.tutorId == request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['estado', 'enlaceReunion', 'calificacion', 'comentario']);
    }

    // ---------------------------------------------------------- calificaciones
    // NUEVO. El id del documento es el id de la tutoría: una sola calificación
    // por tutoría. La crea el estudiante cuando la tutoría está «completada».
    match /calificaciones/{tutoriaId} {
      function tutoria() {
        return get(/databases/$(database)/documents/tutorias/$(tutoriaId)).data;
      }

      // Las visibles son públicas (promedios en Buscar). Las ocultas solo las
      // ven el estudiante que la escribió, el tutor calificado y el admin.
      allow read: if resource.data.estado == 'visible'
        || (autenticado() && (
              resource.data.estudianteId == request.auth.uid ||
              resource.data.tutorId == request.auth.uid ||
              esAdmin()));

      allow create: if autenticado()
        && request.resource.data.estudianteId == request.auth.uid
        && request.resource.data.tutoriaId == tutoriaId
        && request.resource.data.estrellas is int
        && request.resource.data.estrellas >= 1
        && request.resource.data.estrellas <= 5
        && request.resource.data.estado == 'visible'
        && tutoria().estudianteId == request.auth.uid
        && tutoria().tutorId == request.resource.data.tutorId
        && tutoria().estado == 'completada';

      // Solo el administrador modera: estrellas, visibilidad y retroalimentación.
      allow update: if esAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['estrellas', 'estado', 'retroalimentacion', 'editadaPorAdmin', 'editadaEn'])
        && request.resource.data.estado in ['visible', 'oculta']
        && request.resource.data.estrellas is int
        && request.resource.data.estrellas >= 1
        && request.resource.data.estrellas <= 5;

      allow delete: if esAdmin();
    }

    // --------------------------------------------------------- mensajesSoporte
    // NUEVO. Centro de ayuda: cualquier usuario con sesión escribe al equipo;
    // el administrador los gestiona como casos (abierto → revision → resuelto).
    match /mensajesSoporte/{id} {
      allow read: if autenticado()
        && (resource.data.usuarioId == request.auth.uid || esAdmin());

      allow create: if autenticado()
        && request.resource.data.usuarioId == request.auth.uid
        && request.resource.data.estado == 'abierto'
        && request.resource.data.asunto is string
        && request.resource.data.mensaje is string
        && request.resource.data.mensaje.size() <= 1000;

      allow update: if esAdmin()
        && request.resource.data.estado in ['abierto', 'revision', 'resuelto'];
    }

    // ------------------------------------------------------------ hojasDeVida
    // NUEVO. PDF de la hoja de vida del tutor (data URL en base64). El id del
    // documento es el uid del tutor. Lo escribe el propio tutor mientras su
    // estado es «incompleto» (antes de enviar la solicitud); lo lee él mismo
    // y el administrador, que es quien decide aprobar o rechazar.
    match /hojasDeVida/{uid} {
      allow read: if autenticado() && (request.auth.uid == uid || esAdmin());

      allow create, update: if autenticado()
        && request.auth.uid == uid
        && get(/databases/$(database)/documents/usuarios/$(uid)).data.rol == 'tutor'
        && get(/databases/$(database)/documents/usuarios/$(uid)).data.estado == 'incompleto'
        && request.resource.data.tutorId == uid
        && request.resource.data.dataURL is string
        && request.resource.data.dataURL.matches('data:application/pdf;base64,.*')
        && request.resource.data.dataURL.size() < 950000;

      allow delete: if esAdmin();
    }
  }
}
