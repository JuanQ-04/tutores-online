rules_version = '2';

// ============================================================================
//  TutoresOn-Line — reglas de Firestore: DENEGAR TODO a los clientes.
//
//  Ningún navegador habla con la base de datos. El frontend usa la API
//  (backend/, desplegada en Render) y la API usa Firebase Admin SDK, que
//  se salta estas reglas. Así, aunque alguien copie la apiKey pública de
//  js/firebase-config.js, no puede leer ni escribir nada directamente.
//
//  Las validaciones que antes vivían aquí (roles permitidos al registrarse,
//  estados del tutor, tamaño del PDF y de la foto, etc.) ahora están en
//  backend/src/services y backend/src/utils/validar.js.
//
//  Publicar: firebase deploy --only firestore:rules
//  (o pegarlas en Firebase Console → Firestore Database → Reglas).
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
